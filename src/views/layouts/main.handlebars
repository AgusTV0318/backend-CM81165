<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/products">Productos</a>
        <a href="/realtimeproducts">Tiempo Real</a>
        <a href="#" onclick="goToCart()">Mi Carrito</a>
      </nav>
    </header>

    <main>
      {{{body}}}
    </main>

    <footer>
      <p>&copy; 2024 E-commerce Backend</p>
    </footer>

    <script>
      function goToCart() { const cartId = sessionStorage.getItem('cartId'); if
      (cartId) { window.location.href = `/carts/${cartId}`; } else { alert('No
      tienes un carrito activo'); } }
    </script>
  </body>
</html>