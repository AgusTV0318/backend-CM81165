<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/products">Productos</a>
        <a href="/realtimeproducts">Tiempo Real</a>
        <a href="javascript:void(0)" id="cartLink">Mi Carrito</a>
      </nav>
    </header>

    <main>
      {{{body}}}
    </main>

    <footer>
      <p>&copy; 2026 E-commerce Backend</p>
    </footer>

    <script>
      document.getElementById("cartLink")?.addEventListener("click", function()
      { const cartId = sessionStorage.getItem("cartId"); if (cartId && cartId
      !== "null") { window.location.href = "/carts/" + cartId; } else {
      alert("No tienes un carrito todavía. Agrega productos primero."); } });
    </script>
  </body>
</html>